package demo;

public class Datastructurs {
    
    public static void main(String a[]) {
    
        int num[] = { 89, 54, 43, 11, 23, 32, 46, 65, 67, 78};
        int len = num.length;
        int temp;
        int minindex=-1;
        
        System.out.println("Before sorting the array");
        for (int n : num) {
        	System.out.print(n + " ");
        }System.out.println();
        
        for(int i=0;i<len-1;i++) {
        	minindex=i;
        	for(int j=i+1;j<len;j++) {
        		if(num[minindex]>num[j]) {
        			minindex=j;
        		}
        		
        	}
    		temp=num[minindex];
    		num[minindex]=num[i];
    		num[i]=temp;
        	
        }
        
        System.out.println("After sorting the array");
        for (int n : num) {
        	System.out.print(n + " ");
        }
        
        
    }
}
