package demo;

public class Datastructurs {
    
    public static void main(String a[]) {
    
        int num[] = { 89, 54, 43, 11, 23, 32, 46, 65, 67, 78};
        int len = num.length;
        int key;
        int minindex=-1;
        
        System.out.println("Before sorting the array");
        for (int n : num) {
        	System.out.print(n + " ");
        }System.out.println();
        
        for(int i=1;i<len-1;i++) {
        	int j=i-1;
        	key=num[i];
        	while(j>=0 && num[j]>key) {
        		num[j+1]=num[j];
        		j--;
        	}
        	num[j+1]=key;

        }
        
        System.out.println("After sorting the array");
        for (int n : num) {
        	System.out.print(n + " ");
        }
        
        
    }
}
